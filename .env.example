# Ambiente: development | test | production
NODE_ENV=development
PORT=3333

# PostgreSQL (docker compose up -d)
#DATABASE_URL=postgresql://catequese:catequese@localhost:5433/catequese

# Origem do front-end (CORS), separadas por vírgula
CORS_ORIGINS=http://localhost:3000
# URL pública do portal (links nos emails)
FRONTEND_URL=http://localhost:3000

# Tokens de acesso (JWT) — use um segredo longo e aleatório em produção
JWT_ACCESS_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
JWT_ACCESS_TTL_SECONDS=900
# Sessões (refresh token)
REFRESH_TOKEN_TTL_DAYS=30

# Primeira conta de administração geral (pnpm db:seed).
# A palavra-passe só é usada para calcular o hash (bcrypt) guardado na base de
# dados; se a conta já existir, o seed não a altera.
SEED_ADMIN_NAME=Administrador do Portal
SEED_ADMIN_PHONE=+244900000000
SEED_ADMIN_EMAIL=admin@exemplo.ao
SEED_ADMIN_PASSWORD=troque-esta-palavra-passe

# Ficheiros (documentos da matrícula, comprovativos). "uploadthing" ou "memory"
# (memória: só para desenvolvimento sem conta; os ficheiros perdem-se ao reiniciar).
STORAGE_PROVIDER=uploadthing
# Token da app em https://uploadthing.com/dashboard (nunca fazer commit do real).
UPLOADTHING_TOKEN=
UPLOADTHING_APP_ID=
# "private" só no plano pago do UploadThing (no gratuito os ficheiros são
# públicos com endereço aleatório, que a API nunca divulga).
UPLOADTHING_ACL=public-read
# Tamanho máximo por ficheiro, em bytes (5 MB).
UPLOAD_MAX_BYTES=5242880

# Email transaccional (Brevo). Em testes locais sem envio: EMAIL_PROVIDER=console
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@cristoreidapaz.ao
EMAIL_FROM_NAME=Portal da Catequese
EMAIL_REPLY_TO=catequese@cristoreidapaz.ao
EMAIL_API_KEY=
EMAIL_OTP_SECRET=

# Notificações push do navegador (Web Push / VAPID). Gerar as chaves com:
#   npx web-push generate-vapid-keys
# Sem chaves o push fica desligado (as mensagens e o tempo real continuam a funcionar).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto do responsável (mailto: ou https://), exigido pelos serviços de push.
VAPID_SUBJECT=mailto:catequese@cristoreidapaz.ao
