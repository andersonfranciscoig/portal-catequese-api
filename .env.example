# Ambiente: development | test | production
NODE_ENV=development
PORT=3333

# PostgreSQL (docker compose up -d)
DATABASE_URL=postgresql://catequese:catequese@localhost:5433/catequese

# Origem do front-end (CORS), separadas por vírgula
CORS_ORIGINS=http://localhost:3000

# Tokens de acesso (JWT) — use um segredo longo e aleatório em produção
JWT_ACCESS_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
JWT_ACCESS_TTL_SECONDS=900
# Sessões (refresh token)
REFRESH_TOKEN_TTL_DAYS=30

# Primeira conta de administração geral (pnpm db:seed).
# A palavra-passe só é usada para calcular o hash (bcrypt) guardado na base de
# dados; se a conta já existir, o seed não a altera.
SEED_ADMIN_NAME=Administrador do Portal
SEED_ADMIN_PHONE=+244900000000
SEED_ADMIN_EMAIL=admin@exemplo.ao
SEED_ADMIN_PASSWORD=troque-esta-palavra-passe
