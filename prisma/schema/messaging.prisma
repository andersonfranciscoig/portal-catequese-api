// Módulo das mensagens: conversas entre contas e com a equipa da coordenação.
// As contas vivem no módulo de identidade: aqui só se guardam os ids, sem
// chaves estrangeiras entre esquemas.

enum ConversationKind {
  /// Entre duas contas.
  DIRECT
  /// Entre uma conta e toda a equipa da coordenação (coordenação e administração).
  COORDINATION

  @@schema("messaging")
}

model Conversation {
  id                  String           @id @db.Uuid
  kind                ConversationKind
  /// Conversa direta: os dois ids ordenados ("a:b"), única por par.
  directKey           String?          @unique @map("direct_key")
  /// Conversa com a coordenação: a conta (uma conversa por conta).
  subjectAccountId    String?          @unique @map("subject_account_id") @db.Uuid
  createdAt           DateTime         @map("created_at") @db.Timestamptz(3)
  /// Última atividade (criação ou última mensagem).
  updatedAt           DateTime         @map("updated_at") @db.Timestamptz(3)
  lastMessageBody     String?          @map("last_message_body")
  lastMessageAt       DateTime?        @map("last_message_at") @db.Timestamptz(3)
  lastMessageSenderId String?          @map("last_message_sender_id") @db.Uuid

  members  ConversationMember[]
  messages Message[]

  @@index([kind, updatedAt(sort: Desc)])
  @@map("conversations")
  @@schema("messaging")
}

/// Participante (conversa direta ou a conta da conversa com a coordenação) e o
/// que já leu. Na conversa com a coordenação, cada membro da equipa tem aqui a
/// sua leitura a partir da primeira vez que a abre.
model ConversationMember {
  conversationId String    @map("conversation_id") @db.Uuid
  accountId      String    @map("account_id") @db.Uuid
  lastReadAt     DateTime? @map("last_read_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, accountId])
  @@index([accountId])
  @@map("conversation_members")
  @@schema("messaging")
}

model Message {
  id             String   @id @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  body           String
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
  @@schema("messaging")
}
