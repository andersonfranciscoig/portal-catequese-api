// Módulo da catequese: catequizandos, matrículas, turmas, presenças e avaliações.
// As contas (encarregados, adultos, catequistas) vivem no módulo de identidade:
// aqui só se guardam os ids, sem chaves estrangeiras entre esquemas.

enum CatechesisLevel {
  BAPTISM_PRE
  BAPTISM_1
  BAPTISM_2
  BAPTISM_3
  COMMUNION_PRE
  COMMUNION_1
  COMMUNION_2
  COMMUNION_3
  BIBLICAL
  CONFIRMATION_1
  CONFIRMATION_2
  CONFIRMATION_3

  @@schema("catechesis")
}

enum SessionSlot {
  SATURDAY_MORNING
  SATURDAY_AFTERNOON
  SUNDAY_AFTER_MASS

  @@schema("catechesis")
}

enum CenterStatus {
  ACTIVE
  INACTIVE

  @@schema("catechesis")
}

enum Gender {
  MALE
  FEMALE

  @@schema("catechesis")
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GRANDPARENT
  UNCLE_AUNT
  OTHER

  @@schema("catechesis")
}

enum EnrollmentStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PENDING_CONFIRMATION
  CONFIRMED
  REJECTED
  WAITLIST

  @@schema("catechesis")
}

enum EnrollmentType {
  NEW
  RENEWAL
  TRANSFER

  @@schema("catechesis")
}

enum ClassCatechistRole {
  LEAD
  ASSISTANT

  @@schema("catechesis")
}

enum ClassKind {
  REGULAR
  SPECIAL

  @@schema("catechesis")
}

enum ClassAudience {
  CHILD
  ADULT

  @@schema("catechesis")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  JUSTIFIED

  @@schema("catechesis")
}

enum YearOutcome {
  PASSED
  REPEAT

  @@schema("catechesis")
}

/// Ano catequético em curso (datas definidas pela coordenação).
model CatecheticalCalendar {
  id                   String   @id
  label                String
  startsOn             String   @map("starts_on")
  endsOn               String   @map("ends_on")
  /// Prazos das famílias (YYYY-MM-DD); vazio = sem limite.
  enrollmentStartsOn   String?  @map("enrollment_starts_on")
  enrollmentEndsOn     String?  @map("enrollment_ends_on")
  confirmationStartsOn String?  @map("confirmation_starts_on")
  confirmationEndsOn   String?  @map("confirmation_ends_on")
  updatedAt            DateTime @map("updated_at") @db.Timestamptz(3)
  updatedBy            String?  @map("updated_by") @db.Uuid

  @@map("calendar")
  @@schema("catechesis")
}

/// Centro de catequese. Não se apaga: passa a inativo.
model Center {
  id        String       @id @db.Uuid
  name      String
  location  String
  status    CenterStatus
  createdAt DateTime     @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @map("updated_at") @db.Timestamptz(3)

  catechumens   Catechumen[]
  enrollments   Enrollment[]
  classes       CatechesisClass[]
  profiles      CatechistProfile[]
  celebrations  SacramentCelebration[]
  announcements Announcement[]

  @@map("centers")
  @@schema("catechesis")
}

model Catechumen {
  id                   String                @id @db.Uuid
  fullName             String                @map("full_name")
  birthDate            String                @map("birth_date")
  gender               Gender
  address              String?
  baptized             Boolean
  firstCommunion       Boolean               @map("first_communion")
  /// Conta do encarregado (menores).
  guardianAccountId    String?               @map("guardian_account_id") @db.Uuid
  guardianRelationship GuardianRelationship? @map("guardian_relationship")
  /// Conta própria (adultos inscritos por si).
  accountId            String?               @map("account_id") @db.Uuid
  centerId             String                @map("center_id") @db.Uuid
  createdAt            DateTime              @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @map("updated_at") @db.Timestamptz(3)

  center      Center                    @relation(fields: [centerId], references: [id])
  enrollments     Enrollment[]
  sacramentChecks SacramentRequirementCheck[]
  celebrations    SacramentCelebrationCatechumen[]
  sacraments      SacramentRecord[]

  @@index([guardianAccountId])
  @@index([accountId])
  @@index([centerId])
  @@map("catechumens")
  @@schema("catechesis")
}

model Enrollment {
  id                   String           @id @db.Uuid
  code                 String           @unique
  catechumenId         String           @map("catechumen_id") @db.Uuid
  catecheticalYear     String           @map("catechetical_year")
  level                CatechesisLevel
  type                 EnrollmentType
  status               EnrollmentStatus
  preferredSlot        SessionSlot      @map("preferred_slot")
  previousParish       String?          @map("previous_parish")
  notes                String?
  submittedBy          String           @map("submitted_by") @db.Uuid
  centerId             String           @map("center_id") @db.Uuid
  submittedAt          DateTime         @map("submitted_at") @db.Timestamptz(3)
  classId              String?          @map("class_id") @db.Uuid
  decidedBy            String?          @map("decided_by") @db.Uuid
  decidedAt            DateTime?        @map("decided_at") @db.Timestamptz(3)
  updatedAt            DateTime         @map("updated_at") @db.Timestamptz(3)
  /// A família entrega os documentos em papel na secretaria.
  documentsInPerson    Boolean          @default(false) @map("documents_in_person")
  /// Motivo da recusa ou do pedido de documentos (mostrado à família).
  reviewNote           String?          @map("review_note")
  /// Confirmação: a matrícula do ano anterior que esta continua.
  previousEnrollmentId String?          @unique @map("previous_enrollment_id") @db.Uuid
  /// Mudanças de estado: [{ status, at, actorId?, note? }].
  history              Json             @default("[]")

  documents EnrollmentDocument[]

  catechumen Catechumen       @relation(fields: [catechumenId], references: [id], onDelete: Cascade)
  klass      CatechesisClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  center     Center           @relation(fields: [centerId], references: [id])

  /// Uma matrícula por catequizando em cada ano.
  @@unique([catechumenId, catecheticalYear])
  @@index([catecheticalYear, status])
  @@index([centerId])
  @@index([classId])
  @@index([submittedBy])
  @@map("enrollments")
  @@schema("catechesis")
}

model CatechesisClass {
  id               String          @id @db.Uuid
  catecheticalYear String          @map("catechetical_year")
  level            CatechesisLevel
  section          String
  slot             SessionSlot
  startTime        String?         @map("start_time")
  room             String
  capacity         Int
  centerId         String          @map("center_id") @db.Uuid
  kind             ClassKind       @default(REGULAR)
  /// Turma especial: o sacramento que prepara, fora do percurso normal.
  sacrament        SacramentType?
  audience         ClassAudience?
  createdAt        DateTime        @map("created_at") @db.Timestamptz(3)

  center              Center           @relation(fields: [centerId], references: [id])
  catechists          ClassCatechist[]
  enrollments         Enrollment[]
  attendance          AttendanceRecord[]
  evaluations         Evaluation[]
  catechistAttendance CatechistAttendance[]
  celebrations        SacramentCelebrationClass[]
  rollReminders       RollReminder[]

  @@unique([catecheticalYear, level, section, centerId, kind])
  @@index([centerId])
  @@map("classes")
  @@schema("catechesis")
}

model ClassCatechist {
  classId   String             @map("class_id") @db.Uuid
  accountId String             @map("account_id") @db.Uuid
  role      ClassCatechistRole

  klass CatechesisClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([classId, accountId])
  @@index([accountId])
  @@map("class_catechists")
  @@schema("catechesis")
}

model AttendanceRecord {
  classId      String           @map("class_id") @db.Uuid
  catechumenId String           @map("catechumen_id") @db.Uuid
  date         String
  status       AttendanceStatus
  recordedBy   String           @map("recorded_by") @db.Uuid
  recordedAt   DateTime         @map("recorded_at") @db.Timestamptz(3)

  klass CatechesisClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([classId, date, catechumenId])
  @@index([catechumenId])
  @@map("attendance")
  @@schema("catechesis")
}

model Evaluation {
  classId      String       @map("class_id") @db.Uuid
  catechumenId String       @map("catechumen_id") @db.Uuid
  t1           Float?
  t2           Float?
  t3           Float?
  outcome      YearOutcome?
  updatedBy    String       @map("updated_by") @db.Uuid
  updatedAt    DateTime     @map("updated_at") @db.Timestamptz(3)

  klass CatechesisClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([classId, catechumenId])
  @@map("evaluations")
  @@schema("catechesis")
}

enum EnrollmentDocumentKind {
  ID
  BAPTISM
  PHOTO

  @@schema("catechesis")
}

/// Documento enviado pela família (o ficheiro fica no armazenamento; aqui só a chave).
model EnrollmentDocument {
  id           String                 @id @db.Uuid
  enrollmentId String                 @map("enrollment_id") @db.Uuid
  kind         EnrollmentDocumentKind
  fileKey      String                 @map("file_key")
  fileName     String                 @map("file_name")
  fileSize     Int                    @map("file_size")
  contentType  String                 @map("content_type")
  uploadedBy   String                 @map("uploaded_by") @db.Uuid
  uploadedAt   DateTime               @map("uploaded_at") @db.Timestamptz(3)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  /// Um documento de cada tipo por matrícula (um novo substitui o anterior).
  @@unique([enrollmentId, kind])
  @@map("enrollment_documents")
  @@schema("catechesis")
}

enum CatechistStatus {
  IN_TRAINING
  UNAVAILABLE
  INACTIVE

  @@schema("catechesis")
}

/// Estado do catequista definido pela coordenação (ativo/disponível vêm da turma).
model CatechistProfile {
  accountId String           @id @map("account_id") @db.Uuid
  status    CatechistStatus?
  centerId  String           @map("center_id") @db.Uuid
  updatedAt DateTime         @map("updated_at") @db.Timestamptz(3)
  updatedBy String?          @map("updated_by") @db.Uuid

  center Center @relation(fields: [centerId], references: [id])

  @@index([centerId])
  @@map("catechist_profiles")
  @@schema("catechesis")
}

/// Presença do catequista principal em cada encontro da turma (registada pela coordenação).
model CatechistAttendance {
  classId    String           @map("class_id") @db.Uuid
  date       String
  status     AttendanceStatus
  recordedBy String           @map("recorded_by") @db.Uuid
  recordedAt DateTime         @map("recorded_at") @db.Timestamptz(3)

  klass CatechesisClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([classId, date])
  @@map("catechist_attendance")
  @@schema("catechesis")
}

enum SacramentType {
  BAPTISM
  FIRST_COMMUNION
  CONFIRMATION

  @@schema("catechesis")
}

/// O que a coordenação marca à mão (os documentos online e o percurso contam sozinhos).
enum SacramentRequirement {
  BIRTH_CERTIFICATE
  BAPTISM_CERTIFICATE
  RECONCILIATION
  GODPARENT
  PARENTS_MEETING

  @@schema("catechesis")
}

/// Celebração de um sacramento no ano (pode haver várias do mesmo tipo), com o
/// seu grupo de participantes. Sem turmas nem catequizandos escolhidos, os
/// participantes são sugeridos pelo sistema (modo automático).
model SacramentCelebration {
  id               String        @id @db.Uuid
  catecheticalYear String        @map("catechetical_year")
  type             SacramentType
  /// YYYY-MM-DD
  date             String
  /// "HH:mm"
  time             String?
  place            String
  notes            String?
  centerId         String        @map("center_id") @db.Uuid
  /// Batismo celebrado junto com a Primeira Comunhão.
  withCommunion    Boolean       @default(false) @map("with_communion")
  createdAt        DateTime      @map("created_at") @db.Timestamptz(3)
  createdBy        String?       @map("created_by") @db.Uuid
  updatedAt        DateTime      @map("updated_at") @db.Timestamptz(3)
  updatedBy        String?       @map("updated_by") @db.Uuid
  /// Concluída: a coordenação registou quem recebeu de facto.
  completedAt      DateTime?     @map("completed_at") @db.Timestamptz(3)
  completedBy      String?       @map("completed_by") @db.Uuid

  center      Center                           @relation(fields: [centerId], references: [id])
  classes     SacramentCelebrationClass[]
  catechumens SacramentCelebrationCatechumen[]
  records     SacramentRecord[]

  @@index([catecheticalYear, type, date])
  @@index([centerId])
  @@map("sacrament_celebrations")
  @@schema("catechesis")
}

/// Sacramento recebido por um catequizando (no máximo um por tipo). Os "sim/não"
/// `baptized` e `firstCommunion` do catequizando acompanham sempre estes registos.
model SacramentRecord {
  id            String        @id @db.Uuid
  catechumenId  String        @map("catechumen_id") @db.Uuid
  type          SacramentType
  /// YYYY-MM-DD (vazio = desconhecida, ex.: registos antigos)
  date          String?
  parish        String?
  /// Celebração desta paróquia onde o recebeu.
  celebrationId String?       @map("celebration_id") @db.Uuid
  recordedAt    DateTime      @map("recorded_at") @db.Timestamptz(3)
  recordedBy    String?       @map("recorded_by") @db.Uuid

  catechumen  Catechumen            @relation(fields: [catechumenId], references: [id], onDelete: Cascade)
  celebration SacramentCelebration? @relation(fields: [celebrationId], references: [id], onDelete: SetNull)

  @@unique([catechumenId, type])
  @@index([type, date])
  @@index([celebrationId])
  @@map("sacrament_records")
  @@schema("catechesis")
}

/// Turma inteira escolhida para uma celebração.
model SacramentCelebrationClass {
  celebrationId String @map("celebration_id") @db.Uuid
  classId       String @map("class_id") @db.Uuid

  celebration SacramentCelebration @relation(fields: [celebrationId], references: [id], onDelete: Cascade)
  klass       CatechesisClass      @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([celebrationId, classId])
  @@index([classId])
  @@map("sacrament_celebration_classes")
  @@schema("catechesis")
}

/// Catequizando escolhido um a um para uma celebração.
model SacramentCelebrationCatechumen {
  celebrationId String @map("celebration_id") @db.Uuid
  catechumenId  String @map("catechumen_id") @db.Uuid

  celebration SacramentCelebration @relation(fields: [celebrationId], references: [id], onDelete: Cascade)
  catechumen  Catechumen           @relation(fields: [catechumenId], references: [id], onDelete: Cascade)

  @@id([celebrationId, catechumenId])
  @@index([catechumenId])
  @@map("sacrament_celebration_catechumens")
  @@schema("catechesis")
}

/// Alerta de chamada por lançar já enviado (um por turma e encontro). Inserir
/// só se não existir garante que, com várias instâncias, só uma avisa.
model RollReminder {
  classId   String   @map("class_id") @db.Uuid
  /// YYYY-MM-DD (dia do encontro)
  date      String
  alertedAt DateTime @map("alerted_at") @db.Timestamptz(3)

  klass CatechesisClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([classId, date])
  @@map("roll_reminders")
  @@schema("catechesis")
}

/// Requisito de um candidato marcado pela coordenação (entregue / feito).
model SacramentRequirementCheck {
  catechumenId String               @map("catechumen_id") @db.Uuid
  sacrament    SacramentType
  requirement  SacramentRequirement
  met          Boolean
  updatedAt    DateTime             @map("updated_at") @db.Timestamptz(3)
  updatedBy    String               @map("updated_by") @db.Uuid

  catechumen Catechumen @relation(fields: [catechumenId], references: [id], onDelete: Cascade)

  @@id([catechumenId, sacrament, requirement])
  @@map("sacrament_requirement_checks")
  @@schema("catechesis")
}

/// Quem vê o aviso no portal.
enum AnnouncementAudience {
  ALL
  GUARDIANS
  CATECHUMENS
  CATECHISTS

  @@schema("catechesis")
}

/// Aviso publicado pela coordenação (Comunicação).
model Announcement {
  id          String               @id @db.Uuid
  title       String
  body        String
  audience    AnnouncementAudience
  pinned      Boolean              @default(false)
  authorName  String               @map("author_name")
  publishedAt DateTime             @map("published_at") @db.Timestamptz(3)
  updatedAt   DateTime             @map("updated_at") @db.Timestamptz(3)
  /// Conta da coordenação que publicou. Sem chave estrangeira para a identidade.
  createdBy   String               @map("created_by") @db.Uuid
  centerId    String               @map("center_id") @db.Uuid
  reads       AnnouncementRead[]
  center      Center               @relation(fields: [centerId], references: [id])

  @@index([publishedAt(sort: Desc)])
  @@index([centerId])
  @@map("announcements")
  @@schema("catechesis")
}

/// Uma conta abriu o aviso no portal (no máximo uma vez).
model AnnouncementRead {
  announcementId String   @map("announcement_id") @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  readAt         DateTime @map("read_at") @db.Timestamptz(3)

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([announcementId, accountId])
  @@map("announcement_reads")
  @@schema("catechesis")
}

enum CalendarActivityKind {
  ENROLLMENT
  MEETING
  CATECHESIS
  CELEBRATION

  @@schema("catechesis")
}

/// Quem vê a atividade no calendário do portal.
enum CalendarActivityAudience {
  ALL
  GUARDIANS
  CATECHISTS

  @@schema("catechesis")
}

/// Atividade do ano além dos sacramentos (reunião, celebração, matrículas…).
model CalendarActivity {
  id          String                   @id @db.Uuid
  title       String
  description String
  kind        CalendarActivityKind
  audience    CalendarActivityAudience
  /// YYYY-MM-DD
  startsOn    String                   @map("starts_on")
  endsOn      String?                  @map("ends_on")
  createdAt   DateTime                 @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                 @map("updated_at") @db.Timestamptz(3)
  createdBy   String                   @map("created_by") @db.Uuid

  @@index([startsOn])
  @@map("calendar_activities")
  @@schema("catechesis")
}
